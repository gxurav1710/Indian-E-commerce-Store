# ==============================================================================
# UNIFIED E-COMMERCE PLATFORM — COMMERCIAL DEPLOYMENT CONFIGURATION
# Set your domain, payment gateway credentials, and WhatsApp numbers below.
# ==============================================================================

NODE_ENV=production

# --- SERVICE PORTS ---
STOREFRONT_PORT=5000
COMMERCE_API_PORT=5001
NOTIFICATION_SERVICE_PORT=5002
SHIPPING_SERVICE_PORT=5003
ADMIN_PANEL_PORT=5050
CORE_HANDLER_PORT=8085
CONTROL_CENTER_PORT=8090

WHATSAPP_AUTH_API_PORT=4000
WHATSAPP_WORKER_PORT=4001
WHATSAPP_DASHBOARD_PORT=4002

PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
SMS_OBSERVER_PORT=6002
GMAIL_OBSERVER_PORT=6003
PAYMENT_HELP_PORT=3005

# --- DOMAIN & ENVIRONMENT MODE ---
# Set ENVIRONMENT_MODE=DEVELOPMENT for localhost, or PRODUCTION when using your custom domain
ENVIRONMENT_MODE=DEVELOPMENT
PRIMARY_DOMAIN=localhost
DOMAIN_EXTENSION=.shop

STOREFRONT_URL=http://localhost:5000
COMMERCE_API_URL=http://localhost:5001
ADMIN_PANEL_URL=http://localhost:5050
CONTROL_CENTER_URL=http://localhost:8090
CORE_HANDLER_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:5002
SHIPPING_SERVICE_URL=http://localhost:5003

BASE_PAYMENT_API_URL=http://localhost:6100
BASE_CHECKOUT_URL=http://localhost:7000
BASE_ADMIN_URL=http://localhost:6001

WHATSAPP_AUTH_API_URL=http://localhost:4000
WHATSAPP_WORKER_URL=http://localhost:4001
WHATSAPP_DASHBOARD_URL=http://localhost:4002

PAYMENT_SUCCESS_RETURN_URL=http://localhost:5000/account/orders/{order_number}?paymentSuccess=true
PAYMENT_CANCEL_RETURN_URL=http://localhost:5000/cart?paymentCanceled=true
PAYMENT_WEBHOOK_URL=http://localhost:5001/api/v1/webhooks/payment
WHATSAPP_WEBHOOK_URL=http://localhost:4000/api/v1/internal/whatsapp/webhook
WHATSAPP_AUTH_REDIRECT_URI=http://localhost:5000/auth/whatsapp/callback

# --- DATABASE CONFIGURATION ---
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/unified_ecommerce.sqlite

# Optional: Supabase PostgreSQL credentials (if USE_SQLITE_FALLBACK=false)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- SECURITY & CRYPTOGRAPHY SECRETS ---
JWT_SECRET=super_secret_jwt_key_min_32_chars_long_for_security_change_in_production
CONTROL_CENTER_SESSION_SECRET=control_center_operator_session_secret_change_me_prod
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MERCHANT_ID=00000000-0000-0000-0000-000000000001
MERCHANT_WEBHOOK_SECRET=unified_store_webhook_secret_for_payment_verification

# --- BUSINESS & CONTROL CENTER ADMIN CREDENTIALS ---
ADMIN_EMAIL=admin@store.local
ADMIN_PASSWORD=AdminPassword123!
UNIVERSAL_ADMIN_PASSWORD=AdminPassword123!
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=OperatorPassword123!

# --- STORE CONTACTS & NOTIFICATIONS ---
STORE_OWNER_WHATSAPP=+919999999999
WHATSAPP_BOT_PHONE=+919999999998
WHATSAPP_ADAPTER=mock
WHATSAPP_SESSION_PATH=./data/berry_auth
WHATSAPP_ENABLE_VISUAL_WINDOW=false
AUTO_OPEN_BROWSER=false
ADMIN_API_KEY=admin_super_secret_key_change_me_in_prod_12345
WORKER_INTERNAL_SECRET=worker_secret_key_change_me_in_prod_abcde

# --- TELEGRAM BOT (OPTIONAL ALERT BOT) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id
TELEGRAM_POLL_INTERVAL_MS=5000

# --- SHIPPING & LOGISTICS (SHIPROCKET) ---
SHIPPING_PICKUP_PINCODE=110001
SHIPROCKET_EMAIL=logistics@store.local
SHIPROCKET_PASSWORD=your_shiprocket_password

# --- PRODUCT ASSETS DIRECTORY ---
PRODUCT_ASSETS_DIR=./data/product_assets
